# Copy to .env on the deployment host. No provider keys belong in this file.
# The directory must already exist and be writable by UID/GID 10001.
BARDIC_DATA_DIR=/srv/bardic/data
BARDIC_SERVER_CONTEXT=../bardic-server
BARDIC_IMAGE_TAG=local
BARDIC_BIND_ADDRESS=127.0.0.1
BARDIC_HTTP_PORT=8080

# Simultaneous Breeze speech requests, including uncached free samples: 1 to 16.
# One request by default; more slots need capacity in the voice server.
BARDIC_BREEZE_CONCURRENCY=1

# Usually empty: localhost, IPs, local names and .ts.net hosts are accepted.
# For a custom DNS name, add just that hostname (without scheme or port).
BARDIC_ALLOW_HOSTS=
# Same-origin HTTPS needs no extra origin. Only set for a deliberate second web origin.
BARDIC_ALLOW_ORIGINS=
