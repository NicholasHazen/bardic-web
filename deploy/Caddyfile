{
	admin off
	persist_config off
	auto_https off
}

:8080 {
	root * /srv

	@api path /api /api/*
	handle @api {
		# Do not strip /api or rewrite the browser Host. Caddy forwards Origin,
		# Referer, Sec-Fetch-* and Range unchanged, preserving Bardic's guards.
		reverse_proxy bardic-server:8765 {
			header_up Host {http.request.hostport}
			# SSE is flushed immediately by Caddy for text/event-stream. Keep
			# default cancellation when the browser disconnects; no proxy retries.
			transport http {
				compression off
			}
		}
	}

	handle /assets/* {
		# Vite names these files by content hash; missing assets remain 404s.
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		# index.html, sw.js (including its version query), icons and manifest
		# may be stored, but must revalidate after each deployment.
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
